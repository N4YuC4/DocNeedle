# ==============================================================================
# DocNeedle Backend Configuration (.env)
# ==============================================================================

# --- 1. Server & Application ---
APP_NAME=DocNeedle
APP_VERSION=0.1.0
DEBUG=false
HOST=0.0.0.0
PORT=8000
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000","http://localhost:5173","http://127.0.0.1:5173","https://docneedle.vercel.app","*"]

# --- 2. Ingestion & Document Parser (RapidOCR & PDF inspection) ---
MODEL_STORAGE_DIR=models
MAX_UPLOAD_SIZE_MB=50
OCR_ENABLED=true
OCR_MODEL_NAME="RapidOCR (PP-OCRv6 Hybrid Det-Small / Rec-Medium ONNX)"
OCR_DET_MODEL_TYPE=small
OCR_REC_MODEL_TYPE=medium
OCR_TEXT_SCORE=0.5
OCR_LONGEST_EDGE=2500
OCR_DET_LIMIT_SIDE_LEN=960
OCR_DET_BOX_THRESH=0.4
OCR_DET_UNCLIP_RATIO=1.8
MAX_OCR_PAGES=15
OCR_PDF_RENDER_SCALE=2.0
PDF_EMBEDDED_TEXT_MIN_CHARS=50
PDF_EMBEDDED_TEXT_MAX_CHECK_PAGES=5
OCR_FALLBACK_MIN_CHARS=30

# --- 3. Chunking & Splitting (HybridChunker & Coalescence) ---
CHUNKER_TOKENIZER_MODEL=Qwen/Qwen3-Reranker-0.6B
CHUNKER_MAX_TOKENS=768
CHUNKER_REPEAT_TABLE_HEADER=true
CHUNKER_MERGE_PEERS=true
CHUNKER_MAX_CHUNK_CHARS=2500
CHUNKER_MIN_SPLIT_CHARS=200
CHUNKER_OVERFLOW_FACTOR=1.25

# --- 4. BM25 Keyword Search ---
BM25_K1=1.5
BM25_B=0.75
BM25_TOP_K=10

# --- 5. Vector Embedding (Harrier-OSS-v1-0.6B Q4_K_M GGUF) ---
EMBEDDING_MODEL=microsoft/harrier-oss-v1-0.6b
EMBEDDING_QUANTIZATION=q4_k_m
EMBEDDING_DIMENSION=1024
EMBEDDING_BATCH_SIZE=16
EMBEDDING_INSTRUCTION="Instruct: Given a web search query, retrieve relevant passages that answer the query\nQuery: {text}"

# --- 6. Hybrid Retrieval & Reranker ---
RETRIEVAL_TOP_K=10
RRF_CONSTANT=60
RERANKER_MODEL=Qwen/Qwen3-Reranker-0.6B
RERANKER_CANDIDATE_K=40
RERANK_TOP_K=5
MAX_CHUNKS_PER_DOCUMENT=2
RERANKER_INSTRUCTION="Given a web search query, retrieve relevant passages that answer the query"

# --- 7. Extraction Service & LLM Inference (Gemma-4-E2B-it-qat-UD-Q4_K_XL GGUF) ---
EXTRACTION_TOP_K=5
EXTRACTION_CONTEXT_DELIMITER="\n\n---\n\n"
LLM_MODEL_NAME=gemma-4-E2B-it-qat-UD-Q4_K_XL
LLM_N_CTX=16384
LLM_N_GPU_LAYERS=-1
LLM_TEMPERATURE=0.0
LLM_TOP_P=0.95
LLM_MAX_TOKENS=2048
LLM_ENABLE_THINKING=false
LLM_STOP_TOKENS=["</s>","[/INST]","[INST]","<turn|>","<end_of_turn>"]
CONFIDENCE_FOUND_SCORE=0.95
CONFIDENCE_NOT_FOUND_SCORE=0.0

# --- 8. Hardware & Performance Acceleration ---
GPU_ENABLED=false
CPU_THREADS=
CPU_THREADS_BATCH=
MODEL_N_BATCH=512
RERANKER_N_CTX=2048
MODEL_KV_CACHE_TYPE_K=8
MODEL_KV_CACHE_TYPE_V=8
MODEL_FLASH_ATTN=true
